// Generate the typed Prisma client used by the API and seed script.
generator client {
  provider = "prisma-client-js"
}

// Store the assignment data in the configured MySQL database.
datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// Mirror the Stripe subscription lifecycle states used by the entitlement guard.
enum SubscriptionStatus {
  INACTIVE
  ACTIVE
  TRIALING
  PAST_DUE
  CANCELED
  UNPAID
  INCOMPLETE
}

// Keep one demo identity with its recent searches and optional subscription.
model User {
  id               String         @id @default(cuid())
  email            String         @unique
  stripeCustomerId String?        @unique
  recentSearches   RecentSearch[]
  subscription     Subscription?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
}

// Store the signed-in user's search history for the recent-searches panel.
model RecentSearch {
  id        String   @id @default(cuid())
  query     String   @db.VarChar(120)
  locale    String   @db.VarChar(5)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

// Persist the latest Stripe status used for backend nutrition authorization.
model Subscription {
  id                   String             @id @default(cuid())
  stripeSubscriptionId String?            @unique
  status               SubscriptionStatus @default(INACTIVE)
  currentPeriodEnd     DateTime?
  userId               String             @unique
  user                 User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
}

// Record processed Stripe event IDs so webhook delivery is idempotent.
model ProcessedWebhookEvent {
  id        String   @id
  type      String   @db.VarChar(120)
  createdAt DateTime @default(now())
}
